[Unit]
Description=Deploy latest IumOn main after successful CI
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ncloud
WorkingDirectory=/home1/ncloud/iumon
ExecStart=/usr/bin/python3 /opt/iumon-deploy/poll-deployment.py
TimeoutStartSec=28min
UMask=0077
